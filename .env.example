# Express API (HTTP + WebSocket). Production default: Railway URL in lib/api-url.ts
# NEXT_PUBLIC_EXPRESS_BACKEND_URL=http://localhost:4000

# Next.js site URL (optional)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudflare R2 download URL for Electron app (JobTap Assistant Windows executable)
# Example: NEXT_DESKTOP_DOWNLOAD_URL=https://pub-a624e0155d7b4005bd64fb0f35c9e807.r2.dev/JobTap-Assistant.exe
# This is a PUBLIC variable (visible in browser), so URL must be public and non-confidential
# NEXT_DESKTOP_DOWNLOAD_URL=

# Paid subscriptions UI + checkout. Leave unset until Lemon billing is ready.
# NEXT_PUBLIC_PAID_SUBSCRIPTIONS_ENABLED=true
